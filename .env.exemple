# Configuration de Greffier par variables d'environnement.
#
# Copie ce fichier en « .env » à la racine du dépôt, ou dans
# ~/.config/greffier/.env pour qu'il s'applique partout. Toute variable définie
# dans l'environnement l'emporte sur le fichier : on peut donc forcer un réglage
# le temps d'une commande sans rien modifier.
#
#     GREFFIER_COMPTE_RENDU__MOTEUR=ollama greffier traiter reunion.wav
#
# Le double tiret bas sépare la section du champ.

# --- Qui rédige le compte rendu ---------------------------------------------
# claude : Claude Code, la meilleure synthèse. La transcription sort du poste
#          vers l'API Anthropic — seul maillon non local de la chaîne.
# ollama : un modèle sur ta machine, rien ne sort, synthèse plus grossière.
# aucun  : on s'arrête à la transcription attribuée.
GREFFIER_COMPTE_RENDU__MOTEUR=claude
GREFFIER_COMPTE_RENDU__MODELE=qwen3:8b
GREFFIER_COMPTE_RENDU__DESTINATAIRE=

# --- Transcription -----------------------------------------------------------
# whisper.cpp sur macOS (accéléré Metal), faster-whisper ailleurs.
GREFFIER_TRANSCRIPTION__LANGUE=fr
# Noms propres du contexte : c'est ce qui améliore le plus la transcription des
# termes rares. Une liste JSON, parce que la variable doit tenir sur une ligne.
GREFFIER_TRANSCRIPTION__VOCABULAIRE=["Jira","GitLab","sprint","recette","backlog"]

# --- Identification des voix -------------------------------------------------
# Mots à ne jamais prendre pour des prénoms : projets, outils, produits.
GREFFIER_LOCUTEURS__PAS_DES_PRENOMS=["Copernic","Kanban","Trello"]
# Vide : le nombre de participants est déduit par recollage des voix.
# GREFFIER_LOCUTEURS__PERSONNES=6

# --- Audio -------------------------------------------------------------------
# Sur macOS, les deux périphériques à créer une fois (voir le README).
# GREFFIER_AUDIO__ENTREE=Reunion Entree
# GREFFIER_AUDIO__SORTIE=Reunion Sortie

# --- Chemins -----------------------------------------------------------------
# GREFFIER_CHEMINS__MODELES=~/.local/share/greffier/modeles
# GREFFIER_CHEMINS__DONNEES=~/.local/share/greffier
