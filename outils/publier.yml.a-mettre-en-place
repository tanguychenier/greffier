# Fabrique un artefact par système et l'attache à la publication.
#
# Le but est le double-clic : quelqu'un qui n'écrit pas de code télécharge un
# fichier, l'ouvre, et l'outil s'installe. Que cet installeur télécharge ensuite
# des modèles est normal et attendu — 1,7 Go de whisper et la voix ne se glissent
# pas dans une pièce jointe.
#
# Ce que chaque artefact est, et ce qu'il n'est pas :
#
# - **macOS** : le paquet .app que `construire.sh` produit déjà, avec son
#   interpréteur et ses dépendances. Signé **ad hoc** ici, faute du certificat du
#   poste de développement : Gatekeeper le refusera au premier lancement, et il
#   faudra un clic droit puis « Ouvrir ». Le résoudre demande un Developer ID et
#   une notarisation, donc un compte payant et une décision qui n'est pas prise.
# - **Windows** : un dossier avec un .exe, par PyInstaller. Jamais lancé sur une
#   vraie machine Windows au moment d'écrire ces lignes : ce que prouve ce
#   workflow, c'est qu'il se construit et qu'il démarre sur l'exécuteur.
# - **Linux** : l'arbre des sources et son installeur. Un AppImage serait plus
#   commode, et reste à faire.
name: Publier

on:
  push:
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: write

jobs:
  macos:
    name: Paquet macOS
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: Construire le paquet
        # Sans identité de signature sur l'exécuteur, `identite-de-signature.sh`
        # retombe sur la signature ad hoc, ce qui suffit à produire un paquet
        # lançable — et non à satisfaire Gatekeeper.
        run: bash macos/construire.sh
      - name: Archiver
        run: |
          cd /Applications
          ditto -c -k --sequesterRsrc --keepParent Greffier.app \
            "$GITHUB_WORKSPACE/Greffier-macos.zip"
      - uses: actions/upload-artifact@v4
        with:
          name: Greffier-macos
          path: Greffier-macos.zip

  windows:
    name: Exécutable Windows
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - name: Dépendances
        run: |
          python -m pip install -q -e ".[dev,transcription]"
          python -m pip install -q pyinstaller
      - name: Construire
        # `--collect-all sherpa_onnx` parce que ses bibliothèques natives ne
        # sont pas des modules Python : PyInstaller ne les voit pas tout seul.
        run: |
          pyinstaller --noconfirm --name Greffier --windowed `
            --collect-all sherpa_onnx --collect-all soundfile `
            --collect-submodules greffier `
            outils/lanceur_windows.py
      - name: Il démarre
        # Le seul contrôle possible ici : l'exécutable se lance et rend la main.
        # Une fenêtre ne s'ouvre pas sur un exécuteur sans session graphique.
        run: dist\Greffier\Greffier.exe --version
      - name: Archiver
        run: Compress-Archive -Path dist\Greffier -DestinationPath Greffier-windows.zip
      - uses: actions/upload-artifact@v4
        with:
          name: Greffier-windows
          path: Greffier-windows.zip

  linux:
    name: Archive Linux
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Archiver les sources et leur installeur
        run: |
          git archive --format=tar.gz --prefix=greffier/ -o Greffier-linux.tar.gz HEAD
      - uses: actions/upload-artifact@v4
        with:
          name: Greffier-linux
          path: Greffier-linux.tar.gz

  attacher:
    name: Attacher à la publication
    needs: [macos, windows, linux]
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          merge-multiple: true
      - name: Attacher
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release upload "${GITHUB_REF_NAME}" \
            Greffier-macos.zip Greffier-windows.zip Greffier-linux.tar.gz \
            --repo "${GITHUB_REPOSITORY}" --clobber
